# Frontend API URL (public, contains no secret).
NEXT_PUBLIC_API_BASE_URL=
# Website-restricted browser Maps key; server provider keys stay server-only.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=
GEMINI_API_KEY=
# Optional account foundation. Leave both empty to keep Supabase disabled.
# Browser-safe project URL and publishable key only; never use a secret/service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Provider keys belong in the active backend environment, never NEXT_PUBLIC_ variables.
# Optional backend-only setting: false disables public-page/Gemini fare retrieval.
# Public retrieval otherwise uses allowlisted URLs without authenticated sessions.
ROUTEWISE_PUBLIC_PRICING_ENABLED=true

# Backend-only documented Amadeus Flight Offers Search configuration.
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
# test returns clearly labeled sandbox data; use production only with approved access.
AMADEUS_ENV=test
