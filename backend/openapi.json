                                "maximum": 180
                              }
                            },
                            "required": [
                              "latitude",
                              "longitude"
                            ],
                            "additionalProperties": false,
                            "nullable": true
                          },
                          "mapsUrl": {
                            "type": "string",
                            "nullable": true
                          },
                          "openNow": {
                            "type": "boolean",
                            "nullable": true
                          },
                          "priceLevel": {
                            "type": "string",
                            "nullable": true
                          },
                          "attributions": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "provider": {
                                  "type": "string"
                                },
                                "providerUri": {
                                  "type": "string",
                                  "nullable": true
                                }
                              },
                              "required": [
                                "provider",
                                "providerUri"
                              ],
                              "additionalProperties": false
                            }
                          }
                        },
                        "required": [
                          "id",
                          "name",
                          "address",
                          "location",
                          "mapsUrl",
                          "openNow",
                          "priceLevel",
                          "attributions"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "warnings": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "dataMode",
