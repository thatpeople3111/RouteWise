                      "gas",
                      "ev_charging",
                      "pharmacy"
                    ]
                  },
                  "radiusMeters": {
                    "default": 800,
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 5000
                  },
                  "openNow": {
                    "default": false,
                    "type": "boolean"
                  }
                },
                "required": [
                  "location",
                  "category"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "security": [],
