{
  "openapi": "3.0.3",
  "info": {
    "title": "RouteWise API",
    "version": "0.1.0",
    "description": "Student mobility planning. Demo responses are fictional. Route IDs connect cards to route objects."
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {}
  },
  "paths": {
    "/": {
      "get": {
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Service and configuration status; does not call providers",
        "tags": [
          "System"
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/config": {
      "get": {
        "tags": [
          "Frontend"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/trips/plan": {
      "post": {
        "summary": "Plan a trip and rank available routes",
        "tags": [
          "Trips"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "origin": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "address": {
                            "type": "string",
                            "minLength": 2,
                            "maxLength": 300
                          }
                        },
                        "required": [
                          "address"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "placeId": {
                            "type": "string",
                            "minLength": 3,
                            "maxLength": 300
                          }
                        },
                        "required": [
                          "placeId"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "latitude": {
                            "type": "number",
                            "minimum": -90,
                            "maximum": 90
                          },
                          "longitude": {
                            "type": "number",
                            "minimum": -180,
                            "maximum": 180
                          }
                        },
                        "required": [
                          "latitude",
                          "longitude"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "destination": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "address": {
                            "type": "string",
                            "minLength": 2,
                            "maxLength": 300
                          }
                        },
                        "required": [
                          "address"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "placeId": {
                            "type": "string",
                            "minLength": 3,
                            "maxLength": 300
                          }
                        },
                        "required": [
                          "placeId"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "latitude": {
                            "type": "number",
                            "minimum": -90,
                            "maximum": 90
                          },
                          "longitude": {
                            "type": "number",
                            "minimum": -180,
                            "maximum": 180
                          }
                        },
                        "required": [
                          "latitude",
                          "longitude"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "arrivalTime": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                  },
                  "hasCar": {
                    "default": false,
                    "type": "boolean"
                  },
                  "hasBike": {
                    "default": false,
                    "type": "boolean"
                  },
                  "budgetUsd": {
                    "default": 15,
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1000
                  },
                  "maxWalkingMinutes": {
                    "default": 10,
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 180
                  },
                  "avoidTolls": {
                    "default": false,
                    "type": "boolean"
                  },
                  "preference": {
                    "default": "balanced",
                    "type": "string",
                    "enum": [
                      "balanced",
                      "cheapest",
                      "fastest",
                      "least_walking"
                    ]
                  },
                  "nearbyCategories": {
                    "default": [],
                    "maxItems": 3,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "food",
                        "coffee",
                        "parking",
                        "gas",
                        "ev_charging",
                        "pharmacy"
                      ]
                    }
                  }
                },
                "required": [
                  "origin",
                  "destination"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "security": [],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "generatedAt": {
                      "type": "string"
                    },
                    "dataMode": {
                      "type": "string",
                      "enum": [
                        "demo",
                        "live"
                      ]
                    },
                    "routes": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "mode": {
                            "type": "string",
                            "enum": [
                              "TRANSIT",
                              "DRIVE",
                              "WALK",
                              "BICYCLE"
                            ]
                          },
                          "label": {
                            "type": "string"
                          },
                          "durationMinutes": {
                            "type": "number",
                            "minimum": 0
                          },
                          "distanceMeters": {
                            "type": "number",
                            "minimum": 0
                          },
                          "walkingMinutes": {
                            "type": "number",
                            "minimum": 0,
                            "nullable": true
                          },
                          "cost": {
                            "type": "object",
                            "properties": {
                              "amount": {
                                "type": "number",
                                "minimum": 0,
                                "nullable": true
                              },
                              "currency": {
                                "type": "string"
                              },
                              "kind": {
                                "type": "string",
                                "enum": [
                                  "provider_fare",
                                  "no_fare",
                                  "unknown",
                                  "demo"
                                ]
                              },
                              "complete": {
                                "type": "boolean"
                              },
                              "note": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "amount",
                              "currency",
                              "kind",
                              "complete",
                              "note"
                            ],
                            "additionalProperties": false
                          },
                          "steps": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "mode": {
                                  "type": "string",
                                  "enum": [
                                    "TRANSIT",
                                    "DRIVE",
                                    "WALK",
                                    "BICYCLE"
                                  ]
                                },
                                "instruction": {
                                  "type": "string"
                                },
                                "durationMinutes": {
                                  "type": "number",
                                  "minimum": 0
                                },
                                "distanceMeters": {
                                  "type": "number",
                                  "minimum": 0
                                },
                                "transit": {
                                  "type": "object",
                                  "properties": {
                                    "line": {
                                      "type": "string"
                                    },
                                    "headsign": {
                                      "type": "string",
                                      "nullable": true
                                    },
                                    "departureStop": {
                                      "type": "string",
                                      "nullable": true
                                    },
                                    "arrivalStop": {
                                      "type": "string",
                                      "nullable": true
                                    },
                                    "departureTime": {
                                      "type": "string",
                                      "nullable": true
                                    },
                                    "arrivalTime": {
                                      "type": "string",
                                      "nullable": true
                                    },
                                    "agencies": {
                                      "type": "array",
                                      "items": {
                                        "type": "object",
                                        "properties": {
                                          "name": {
                                            "type": "string"
                                          },
                                          "url": {
                                            "type": "string",
                                            "nullable": true
                                          }
                                        },
                                        "required": [
                                          "name",
                                          "url"
                                        ],
                                        "additionalProperties": false
                                      }
                                    }
                                  },
                                  "required": [
                                    "line",
                                    "headsign",
                                    "departureStop",
                                    "arrivalStop",
                                    "departureTime",
                                    "arrivalTime",
                                    "agencies"
                                  ],
                                  "additionalProperties": false,
                                  "nullable": true
                                }
                              },
                              "required": [
                                "mode",
                                "instruction",
                                "durationMinutes",
                                "distanceMeters",
                                "transit"
                              ],
                              "additionalProperties": false
                            }
                          },
                          "encodedPolyline": {
                            "type": "string",
                            "nullable": true
                          },
                          "destination": {
                            "type": "object",
                            "properties": {
                              "latitude": {
                                "type": "number",
                                "minimum": -90,
                                "maximum": 90
                              },
                              "longitude": {
                                "type": "number",
                                "minimum": -180,
                                "maximum": 180
                              }
                            },
                            "required": [
                              "latitude",
                              "longitude"
                            ],
                            "additionalProperties": false,
                            "nullable": true
                          },
                          "mapsUrl": {
                            "type": "string"
                          },
                          "departureTime": {
                            "type": "string",
                            "nullable": true
                          },
                          "arrivalTime": {
                            "type": "string",
                            "nullable": true
                          },
                          "timing": {
                            "type": "string",
                            "enum": [
                              "scheduled",
                              "estimated_now",
                              "demo"
                            ]
                          },
                          "constraints": {
                            "type": "object",
                            "properties": {
                              "budget": {
                                "type": "string",
                                "enum": [
                                  "met",
                                  "exceeded",
                                  "unknown"
                                ]
                              },
                              "walking": {
                                "type": "string",
                                "enum": [
                                  "met",
                                  "exceeded",
                                  "unknown"
                                ]
                              },
                              "arrival": {
                                "type": "string",
                                "enum": [
                                  "met",
                                  "missed",
                                  "unknown",
                                  "not_requested"
                                ]
                              },
                              "eligible": {
                                "type": "boolean"
                              }
                            },
                            "required": [
                              "budget",
                              "walking",
                              "arrival",
                              "eligible"
                            ],
                            "additionalProperties": false
                          },
                          "warnings": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        },
                        "required": [
                          "id",
                          "mode",
                          "label",
                          "durationMinutes",
                          "distanceMeters",
                          "walkingMinutes",
                          "cost",
                          "steps",
                          "encodedPolyline",
                          "destination",
                          "mapsUrl",
                          "departureTime",
                          "arrivalTime",
                          "timing",
                          "constraints",
                          "warnings"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "best": {
                      "type": "string",
                      "nullable": true
                    },
                    "cheapest": {
                      "type": "string",
                      "nullable": true
                    },
                    "fastest": {
                      "type": "string",
                      "nullable": true
                    },
                    "recommendation": {
                      "type": "object",
                      "properties": {
                        "source": {
                          "type": "string",
                          "enum": [
                            "rules",
                            "gemini"
                          ]
                        },
                        "reason": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "source",
                        "reason"
                      ],
                      "additionalProperties": false
                    },
                    "nearby": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "category": {
                            "type": "string",
                            "enum": [
                              "food",
                              "coffee",
                              "parking",
                              "gas",
                              "ev_charging",
                              "pharmacy"
                            ]
                          },
                          "places": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "id": {
                                  "type": "string"
                                },
                                "name": {
                                  "type": "string"
                                },
                                "address": {
                                  "type": "string"
                                },
                                "location": {
                                  "type": "object",
                                  "properties": {
                                    "latitude": {
                                      "type": "number",
                                      "minimum": -90,
                                      "maximum": 90
                                    },
                                    "longitude": {
                                      "type": "number",
                                      "minimum": -180,
                                      "maximum": 180
                                    }
                                  },
                                  "required": [
                                    "latitude",
                                    "longitude"
                                  ],
                                  "additionalProperties": false,
                                  "nullable": true
                                },
                                "mapsUrl": {
                                  "type": "string",
                                  "nullable": true
                                },
                                "openNow": {
                                  "type": "boolean",
                                  "nullable": true
                                },
                                "priceLevel": {
                                  "type": "string",
                                  "nullable": true
                                },
                                "attributions": {
                                  "type": "array",
                                  "items": {
                                    "type": "object",
                                    "properties": {
                                      "provider": {
                                        "type": "string"
                                      },
                                      "providerUri": {
                                        "type": "string",
                                        "nullable": true
                                      }
                                    },
                                    "required": [
                                      "provider",
                                      "providerUri"
                                    ],
                                    "additionalProperties": false
                                  }
                                }
                              },
                              "required": [
                                "id",
                                "name",
                                "address",
                                "location",
                                "mapsUrl",
                                "openNow",
                                "priceLevel",
                                "attributions"
                              ],
                              "additionalProperties": false
                            }
                          }
                        },
                        "required": [
                          "category",
                          "places"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "groundedGuidance": {
                      "type": "object",
                      "properties": {
                        "text": {
                          "type": "string"
                        },
                        "groundingMetadata": {
                          "type": "object",
                          "properties": {},
                          "additionalProperties": {}
                        }
                      },
                      "required": [
                        "text",
                        "groundingMetadata"
                      ],
                      "additionalProperties": false,
                      "nullable": true
                    },
                    "warnings": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "attribution": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "generatedAt",
                    "dataMode",
                    "routes",
                    "best",
                    "cheapest",
                    "fastest",
                    "recommendation",
                    "nearby",
                    "groundedGuidance",
                    "warnings",
                    "attribution"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/places/nearby": {
